# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Security headers for static assets (audit H1, 2026-11-25). Assets that match a file are served
# BEFORE the Worker runs, so its wrapper (`withSecurityHeaders`) never sees them; Worker
# responses never get these rules. The values MUST equal
# `@seanperez/server/http/security-headers` (`ADMIN_SECURITY_HEADERS`):
# `packages/server/scripts/security-headers-test.ts` checks it. A header matched by two rules is
# joined with a comma, so no rule below repeats one of these.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: fullscreen=(self), accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: blob: https:; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'; worker-src 'self'

/*service-worker.js
  Cache-Control: no-store
  Content-Type: application/javascript

/build/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
