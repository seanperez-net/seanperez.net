/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The owner's admin app (`.claude/rules/admin.md`): its own Worker, the site's D1.
  "name": "seanperez-net-admin",
  // The seanperez.net Cloudflare account (same as apps/web). An identifier, not a credential.
  // Pinned so a deploy can never land in another account the logged-in user can reach.
  "account_id": "f90e0eed6a9a5a04351354f206c5cacb",
  "main": "./dist/_worker.js",
  "compatibility_date": "2025-12-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSET",
    "directory": "./dist",
  },
  /**
   * NO routes yet: the owner adds the hostname (e.g. admin.seanperez.net) together with its
   * Cloudflare Access application (PLAN.md "PLAN: `apps/admin`", owner's steps). No
   * `*.workers.dev` URL either: it would reach this Worker with no Access in front (wrangler's
   * default is true). Until the hostname exists a deploy is unreachable, on purpose.
   */
  "workers_dev": false,
  // Nor version Preview URLs (<version>-<name>.<subdomain>.workers.dev): unset, wrangler 4.165
  // leaves the choice to the API (`wrangler-dist/cli.js` `getSubdomainValues`).
  "preview_urls": false,
  /**
   * The SAME database as apps/web (posts, profile, contact messages, accounts). An identifier,
   * not a credential. The migrations are `@seanperez/data`'s (`packages/data/migrations`, the
   * same folder as apps/web's `migrations_dir`). Apply `--local` from apps/web, whose local state
   * `pnpm dev:admin` shares (`vite.config.ts`); from here `--local` would fill this app's own,
   * unused `.wrangler/`. `--remote` is the owner's, from either app (one database).
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seanperez-net",
      "database_id": "bd51b663-f4bf-4dab-96fc-42b4d1f8e3d4",
      "migrations_dir": "../../packages/data/migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
