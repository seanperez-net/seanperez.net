{
  "name": "@seanperez/web",
  "description": "seanperez.net: personal site and resume (Qwik v2 on Cloudflare)",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts",
    "cf-typegen": "wrangler types --include-runtime=false ./worker-configuration.d.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\" \"scripts/**/*.ts\"",
    "og": "node scripts/og.ts",
    "icons": "node scripts/icons.ts",
    "repos": "node scripts/repos.ts",
    "screenshots": "node scripts/screenshots.ts",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler dev",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install webkit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@eslint/js": "latest",
    "@playwright/test": "1.65.1",
    "@qwik.dev/core": "^2.0.0-rc.5",
    "@qwik.dev/mcp": "2.0.0-rc.5",
    "@qwik.dev/router": "^2.0.0-rc.5",
    "@resvg/resvg-wasm": "2.6.2",
    "@seanperez/chat": "workspace:*",
    "@seanperez/data": "workspace:*",
    "@seanperez/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "25.6.0",
    "eslint": "10.0.3",
    "eslint-plugin-qwik": "^2.0.0-rc.5",
    "globals": "17.0.0",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "satori": "0.63.2",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "typescript-plugin-css-modules": "latest",
    "vite": "8.2.4",
    "vite-tsconfig-paths": "^4.2.1",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "zod": "^4.6.7"
  }
}
