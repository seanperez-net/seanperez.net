{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Sean Perez",
  "short_name": "Sean Perez",
  "description": "Sean Perez: posts, projects and code.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f9f9ff",
  "theme_color": "#415f91",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Contacts",
      "short_name": "Contacts",
      "description": "Contacts, with Sean Perez's résumé",
      "url": "/contacts/",
      "icons": [
        {
          "src": "/icons/shortcut-contacts-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Maps",
      "short_name": "Maps",
      "description": "The map and its live nodes",
      "url": "/maps/",
      "icons": [
        {
          "src": "/icons/shortcut-maps-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/home-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home: the feed, with the navigation rail"
    },
    {
      "src": "/screenshots/maps-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Maps on a phone"
    }
  ]
}
