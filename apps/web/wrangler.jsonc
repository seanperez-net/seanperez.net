/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seanperez-net",
  // The seanperez.net Cloudflare account. An identifier, not a credential. Pinned so a deploy
  // can never land in another account the logged-in user also has access to.
  "account_id": "f90e0eed6a9a5a04351354f206c5cacb",
  "main": "./dist/_worker.js",
  "compatibility_date": "2025-12-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  /**
   * Custom domain: Cloudflare creates the DNS record and certificate on deploy.
   * The seanperez.net zone must be in the account that deploys.
   */
  "routes": [
    { "pattern": "seanperez.net", "custom_domain": true },
    { "pattern": "www.seanperez.net", "custom_domain": true },
  ],
  // No `*.workers.dev` URL (wrangler's default is true): the site is only served on the custom
  // domains. (The reason was /admin outside Access; /admin left for apps/admin 2026-11-25.)
  "workers_dev": false,
  // No workers.dev Preview URLs either (QWIK-DEFAULTS.md 2026-11-25).
  "preview_urls": false,
  /**
   * The feed's posts (`migrations/`, table `post`), the profile (`profile`) and the contact
   * form's messages (`message`, the only table a visitor writes to). The database existed, empty, since
   * 2026-11-21. The migrations live in `packages/db/migrations` (`@seanperez/db` owns them since
   * 2026-11-25; apps/admin points at the same folder). Applied by hand, never by the deploy, from
   * THIS folder (the admin's `pnpm dev:admin` shares this app's local state):
   * `pnpm wrangler d1 migrations apply seanperez-net --local` (dev) / `--remote` (the owner).
   * An identifier, not a credential.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seanperez-net",
      "database_id": "bd51b663-f4bf-4dab-96fc-42b4d1f8e3d4",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  "vars": {
    // The contact form's Turnstile SITE key: public by design (it is sent to every browser).
    // EMPTY until the owner creates the widget (PLAN.md "Waiting on the owner"); while empty,
    // /contact/ says the form is not open yet. The SECRET is `wrangler secret put
    // TURNSTILE_SECRET_KEY`, never here. `.dev.vars` overrides both with Cloudflare's test keys.
    "TURNSTILE_SITE_KEY": "",
    // The hostnames Siteverify may report for a token (the widget's own domains).
    "TURNSTILE_HOSTNAMES": "seanperez.net,www.seanperez.net",
  },
  /**
   * Contact accounts (2026-11-25, `.claude/notes/contact-verify-email-plan-2026-11-25.md`): the
   * owner's "new verified message" notification ONLY, to the secret `OWNER_NOTIFY_TO` (the owner's
   * verified Email Routing destination; free on any plan, no Email Sending onboarding needed:
   * developers.cloudflare.com/email-service/configuration/destination-addresses/). No
   * `destination_address` here: it would publish that address in this public repo. Mail to
   * visitors goes through Resend (`@seanperez/server` `src/mail/mail.server.ts`, secret `RESEND_API_KEY`). Other
   * secrets: `AUTH_SECRET` (HMAC key for the 6-digit codes). All three: `wrangler secret put`.
   */
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["noreply@seanperez.net"] },
  ],
  /**
   * Live nodes (Maps / Devices, 2026-11-24): ONE Durable Object, `NodeHub` (`src/nodes/node-hub.server.ts`,
   * exported from `public/_worker.js`), that keeps real devices' reports (no demo devices since 2026-11-25)
   * and fans them out to browsers over hibernating WebSockets. SQLite-backed: the only kind on
   * Workers Free. The migration is applied by the next `wrangler deploy`. Devices post with the
   * secret `NODE_INGEST_TOKEN` (`wrangler secret put NODE_INGEST_TOKEN`; `.dev.vars` locally).
   */
  "durable_objects": {
    "bindings": [{ "name": "NODE_HUB", "class_name": "NodeHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NodeHub"] }],
  /**
   * Rate limiting (2026-11-25, `.claude/notes/rate-limiting-research-2026-11-25.md`, approved by
   * the owner): a cheap, approximate, per-location gate in front of D1 / Turnstile Siteverify /
   * Resend (`@seanperez/server` `src/limits/limit.server.ts` `allow`). The hard limits are the D1 caps. Keys are route
   * names or SHA-256 session hashes, never IPs. Periods can only be 10 or 60 s
   * (developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/). ONE binding at 60 per
   * 60 s per key; each endpoint weights its calls with `delta` (`WEIGHT` in limit.server.ts), so
   * e.g. a contact send counts 6 (10 a minute) and a search 1 (60 a minute). namespace_id: any
   * integer unique in this account (not secret).
   */
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
