{
  "name": "seanperez-net",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @seanperez/web dev",
    "build": "pnpm --filter @seanperez/web build",
    "preview": "pnpm --filter @seanperez/web preview",
    "deploy": "pnpm --filter @seanperez/web run deploy",
    "check-types": "pnpm -r --parallel run check-types",
    "lint": "pnpm -r --parallel run lint",
    "format": "pnpm -r --parallel run fmt",
    "format:check": "pnpm -r --parallel run fmt.check"
  }
}
